---------------
 0.0.1
(1 row)

SELECT acdat_contains(
    'ushers',
    acdat_compile(ARRAY['he', 'she', 'his', 'hers'])
);
 acdat_contains 
----------------
 t
(1 row)

SELECT acdat_contains(
    'the quick brown fox',
    acdat_compile(ARRAY['slow', 'turtle'])
);
 acdat_contains 
----------------
 f
(1 row)

SELECT acdat_contains(
    '发现病毒特征码',
    acdat_compile(ARRAY['病毒', '木马'])
);
 acdat_contains 
----------------
